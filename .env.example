# Slack credentials (Socket Mode). Get these from https://api.slack.com/apps
# Bot token: OAuth & Permissions -> Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token
# App-level token: Basic Information -> App-Level Tokens (scope: connections:write)
SLACK_APP_TOKEN=xapp-your-app-token
# Stream replies live (tool calls shown as a timeline). "false" posts once at the end.
SLACK_STREAM_UPDATES=true
# Where Slack traffic comes from: `socket` (default) opens Socket Mode in this process;
# `inbox` reads what the separate gateway (src/gateway.ts) queued, so a bot restart
# never drops the connection.
# SLACK_TRANSPORT=socket
# The gateway's queue (its own file, only used with SLACK_TRANSPORT=inbox). Keep it
# OUTSIDE the git checkout (`~/` works); the gateway and the bot both open it.
# Recommended: INBOX_DATABASE_PATH=~/.jarvis/data/inbox.db
# INBOX_DATABASE_PATH=data/inbox.db

# Bot identity - these only bootstrap a fresh database. Once set, the dashboard-managed
# values in the DB take precedence, so the code stays generic.
BOT_NAME=Assistant
BOT_THINKING_LABEL=working on it...
# BOT_THINKING_DONE_LABEL=✅

# Jarvis's brain: "claude-cli" wraps your local Claude Code CLI (full tool access),
# "anthropic" calls the API directly.
LLM_PROVIDER=claude-cli

# --- claude-cli provider ---
# Long-lived auth for the CLI, from `claude setup-token`. Strongly recommended:
# without it the bot borrows whatever interactive login happens to be on the
# machine, so every turn starts failing the moment that session expires.
CLAUDE_CODE_OAUTH_TOKEN=

# Path/name of the claude binary
CLAUDE_BIN=claude
# Model alias or id passed to the CLI (e.g. opus, sonnet, claude-opus-4-8)
CLAUDE_MODEL=opus
# Model for `pal` chat. Their turns are ordinary conversation, so the cheapest
# model is the sensible default; override per role at runtime with
# `<prefix> model <role> <name>`, or `default` to fall back to CLAUDE_MODEL.
CLAUDE_MODEL_PAL=haiku
# Default for a call that carries no role policy. A turn always has one, and only
# the OWNER's turn runs with --dangerously-skip-permissions; every other role runs
# with --permission-mode dontAsk and an allow-list (SANDBOX_TOOLS below).
CLAUDE_SKIP_PERMISSIONS=true
# Allow-list of every role but the owner, comma separated, replacing the built-in
# default (Read/Grep/Glob, web, git and gh read commands, read-only Notion/GitHub
# MCP). No shell reader is listed: an explicit Bash(cat:*) matches any path and
# would read secrets Read is denied. The CLI itself runs cat/ls/head/grep inside the
# scratch dir without a rule. sed, find, rg and jq can write, run code or print the
# environment and a text denial does not hold against quoting, so adding any of
# them is your call. Applies to pal, to an executer or admin with no dashboard tool list
# and to a role the bot does not recognise. The bot's own
# helpers in bin/ and every denial (writes, sed -i, find -exec, secrets, databases,
# orca) are added on top. Leave empty for the default.
# SANDBOX_TOOLS=Read,Grep,Glob,WebFetch,Bash(cat:*),Bash(ls:*),Bash(git log:*)
# Working directory the CLI runs in (scopes file/tool access). Leave blank to use
# a neutral dir outside Jarvis's own source (so it never treats this repo as its own
# job). Set to a project path if you want its tools to operate there.
CLAUDE_CWD=
# Hard timeout per reply, ms
CLAUDE_TIMEOUT_MS=120000
# Orca worktree (selector) the bot opens its own terminal in. Every turn gets
# that terminal's handle as ORCA_TERMINAL_HANDLE, so `orca orchestration` works
# from Slack. Orca must know the folder (`orca repo list`). Blank = path:~/Workspaces,
# `off` disables. With Orca not running turns simply get no handle.
ORCA_TERMINAL_WORKTREE=

# --- anthropic provider (only needed when LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Command interfaces. COMMAND_PREFIX is the message trigger (the legacy "!" always
# works too); SLASH_COMMAND is the Slack slash command you register in the app.
COMMAND_PREFIX=//bot
SLASH_COMMAND=/bot

# Owner Slack user id (full control, cannot be removed from the allowlist).
# Your own Slack member id (starts with U, from your profile > Copy member ID).
OWNER_SLACK_ID=

# Channel that gets one restart notice listing every thread waiting on it
# (edited as more queue up). Leave empty to post nothing. The inner child also
# logs voice drift here unless the inner_child_drift_channel setting is set.
DRAIN_NOTICE_CHANNEL=

# While a restart waits for running turns, new messages are still answered, each
# turn on this budget (ms). Past it the thread is told to hold on, the turn is
# cut and picked up again after the restart on the same session.
RESTART_TURN_BUDGET_MS=120000

# Test runs only, read from the environment by `bun test` (bunfig.toml preload),
# not by the bot: a full `bun test` queues behind other full runs on this host.
# JARVIS_TEST_LOCK=0                  # do not queue
# JARVIS_TEST_LOCK_TIMEOUT_MS=1800000 # give up (exit 1) after waiting this long
# JARVIS_TEST_NICE=10                 # priority of a full run, 0-19
# JARVIS_TEST_LOCK_DIR=               # default ~/.cache/jarvis-test-lock

# Idle-worker reaper: Orca worker sessions are interactive agents that stay open
# (hundreds of MB each, plus MCP child processes) after their work ends. Every
# ORCA_REAP_INTERVAL_MS the bot closes, through Orca, the ones whose task is
# finished/failed/blocked with nothing pending (or tied to no task) and whose
# terminal has been silent for ORCA_REAP_IDLE_MS. Never touched: a worker with a
# live watch or an unanswered question, one kept open, or anything not started by
# Orca. Interval 0 turns it off; ORCA_REAP_DRY_RUN=true only logs.
# ORCA_REAP_INTERVAL_MS=1800000
# ORCA_REAP_IDLE_MS=10800000
# ORCA_REAP_DRY_RUN=false

# Stale-promise sweep: a turn that ended on "next I will ..." with no watch,
# reminder or worker left to do it. Every STALE_PROMISE_INTERVAL_MS the bot steers
# once (the same internal turn as `tell`, nothing posted by the sweep) each thread
# whose newest message is its own promise, STALE_PROMISE_MIN_AGE_MS old or more,
# inside the last STALE_PROMISE_WINDOW_MS, at most STALE_PROMISE_MAX_NUDGES per
# sweep. Interval 0 turns it off.
# STALE_PROMISE_INTERVAL_MS=900000
# STALE_PROMISE_MIN_AGE_MS=1800000
# STALE_PROMISE_WINDOW_MS=86400000
# STALE_PROMISE_MAX_NUDGES=3

# Channel told when the host loses its connection. A notice is kept armed as a
# Slack scheduled message and re-armed every minute; if the host drops off it
# cannot cancel it, so Slack posts it ~10 min after the last heartbeat, and it is edited to "back
# online" when the host returns. A channel id (C...), not a name. A deliberate
# stop cancels it. Leave empty for no alarm.
OFFLINE_ALARM_CHANNEL=

# Channel that gets the owner's copy of other people's slash commands: a header
# saying who ran what, the output in its thread. A channel id (C...). Leave
# empty to send it to the owner's DM.
SLASH_MIRROR_CHANNEL=

# GitHub App: people call the bot from an issue/PR (`@<slug>` in a comment or
# review, or the label below) and it answers there, as the app. Started only
# when the app id, private key and webhook secret can all be found. Secrets stay
# in files outside the repo; the defaults point at ~/.config/jarvis/github-app/.
# GITHUB_APP_ID=                 # unset: read from app.json beside the key
# GITHUB_APP_PRIVATE_KEY_PATH=   # default ~/.config/jarvis/github-app/private-key.pem
# GITHUB_APP_WEBHOOK_SECRET_PATH= # default ~/.config/jarvis/github-app/webhook-secret
# GITHUB_APP_WEBHOOK_SECRET=     # overrides the file; prefer the file
# Loopback port of the webhook listener; Tailscale Funnel proxies
# https://<host>/github -> http://127.0.0.1:<port> (with or without the prefix).
GITHUB_APP_PORT=2003
GITHUB_APP_SLUG=jarvis
# The app is public: it acts only on repositories owned by these accounts
# (comma list). Empty (the default) means it acts for no owner.
GITHUB_APP_ALLOWED_OWNERS=
GITHUB_APP_LABEL=jarvis

# The bot's own PRs, split across two gh logins on this host: the author opens
# the PR and answers reviews, the reviewer posts its reviews (request changes or approve) and merges. Both or neither,
# and two different logins.
# SELF_PR_AUTHOR=
# SELF_PR_REVIEWER=

# GitHub owners (comma separated, case-insensitive) whose PRs `quick-review` also
# posts non-blocking findings for. Empty: blockers only, everywhere.
# REVIEW_EXTENDED_OWNERS=

# Secret-shaped variable names (`*_TOKEN`, `*_SECRET`, `*_API_KEY`...) an agent turn may
# still inherit, comma separated. A turn runs a shell that a model drives while it reads
# untrusted text, so its environment is the bot's MINUS every credential-shaped variable
# (SLACK_BOT_TOKEN, SLACK_APP_TOKEN, ANTHROPIC_API_KEY, ...); CLAUDE_CODE_OAUTH_TOKEN is always
# kept because the CLI needs it. Slack goes through a per-turn ticket instead. Name a variable
# only when a tool a turn runs genuinely needs it. Empty (the default) passes none.
# TURN_ENV_PASSTHROUGH=
# Local database MCP servers on this host (names as `claude mcp list` shows
# them), comma separated. SECURITY: each is denied BY NAME to every role that
# may not query databases (pal, executer, side questions). A denial has to name
# the server - a bare `mcp__` prefix denies nothing - so a server missing here is
# reachable by EVERY role, including a pal in a side channel. Empty denies
# nothing: list every database server you configure, and add new ones here when
# you add them to ~/.claude.json.
# DB_MCP_SERVERS=pg-prod,pg-staging,clickhouse-ro
# The subset of DB_MCP_SERVERS the executer role may query. Only servers whose
# credential is read-only on the server side (not a write user, not an
# org-wide management key). Empty: executers get none.
# EXECUTER_DB_MCP_SERVERS=pg-prod,clickhouse-ro

# User-scope MCP servers (names as `claude mcp list` shows them) to keep out of
# the Orca workers the bot starts. Every claude session loads every server in
# ~/.claude.json, and a stdio server is a process (or three) per session, so a
# batch of workers multiplied them: 17 sessions held ~1.3GB and pushed a host into
# swap. Before each worker starts, the bot's prompts run bin/worker-mcp-trim.ts,
# which writes these names into the worker home's .claude/settings.local.json
# (deniedMcpServers). Empty (the default) keeps every server in every worker.
# The bot's own turns are not affected, and a name that matches no server in
# ~/.claude.json is logged at boot.
# WORKER_MCP_DENY=pg-prod,pg-staging,clickhouse-ro

# The one folder every Orca worker starts in (`--worktree path:<it>`), so the
# exclusion above lands in a folder only workers use and never in one you work in
# (~/Workspaces). Created at boot; bin/worker-mcp-trim.ts registers it with Orca as
# a plain folder when a worker is about to start. Blank = ~/.jarvis/worker-home.
# WORKER_HOME_DIR=~/.jarvis/worker-home

# Admin dashboard (local, loopback-only, no auth token)
DASHBOARD_PORT=2002
# If you reach the dashboard through a proxy/tunnel/port-forward, add its browser
# origin(s) here (comma separated, e.g. https://abc.devtunnels.ms). Loopback is
# always allowed. A blocked POST returns the exact origin to add.
DASHBOARD_ALLOWED_ORIGINS=

# Path to the live sqlite database file. Keep it OUTSIDE the git checkout (`~/`
# works).
# Recommended: DATABASE_PATH=~/.jarvis/data/bot.db
DATABASE_PATH=data/bot.db
# One-time move of an existing database: if DATABASE_PATH does not exist yet and
# this file does, the first boot copies a consistent snapshot of it over (a
# relative path is relative to the checkout). The old file is only read. If it is
# set but the file is missing and DATABASE_PATH is not there either, the bot
# refuses to start instead of creating an empty database. Safe to leave set once
# the destination exists.
# DATABASE_MIGRATE_FROM=data/bot.db
# Per-user Claude Code tokens (the `token` command / review gate). Their own
# database, encrypted under a key that stays out of git.
TOKEN_DATABASE_PATH=data/tokens.db
# TOKEN_DATABASE_MIGRATE_FROM=data/tokens.db
TOKEN_KEY_PATH=data/tokens.key
# Where the key lives: `file` (default, TOKEN_KEY_PATH) or `keychain` (macOS: one
# login-Keychain item; a key file at TOKEN_KEY_PATH is moved in on first boot and
# deleted after a byte-for-byte read-back). Locked Keychain: the bot boots with
# per-user tokens and 2FA seeds off. Missing item + no file + existing rows: no boot.
# TOKEN_KEY_SOURCE=file
# TOKEN_KEY_KEYCHAIN_SERVICE=jarvis-token-key
# Where `bun bin/db-backup.ts` writes snapshots of both databases. A private git
# repository here plus `--commit` keeps the database history in git.
# DATABASE_BACKUP_DIR=~/.jarvis/backups
# Opt-in end-to-end test against real Slack (`bun run test:e2e`, README "Testing").
# JARVIS_E2E=1 is set by the script. JARVIS_E2E_CHANNEL is required (a channel id
# the bot is a member of); without it the e2e suite skips itself.
# JARVIS_E2E_CHANNEL=
# JARVIS_E2E_USER=
# JARVIS_E2E_KEEP=1

# Where the memory adapter is mirrored on disk (re-rendered from the database on every
# write; never edit it, use `adapter export` / `adapter import`).
# ADAPTER_PATH=data/adapter-mirror
# Bytes of the adapter that may load into EVERY prompt.
# ADAPTER_BUDGET=8000
# Commands one chat turn may trigger through the run helper (a runaway guard).
# COMMAND_TICKET_USES=50
# Folder for the activity/error logs (one JSON line per event).
# LOG_DIR=logs

# --- read straight from the environment, not through src/config/env.ts ---
# The orca binary bin/orca-worker-wait.ts calls (default `orca` on PATH).
# ORCA_BIN=orca
# Claude config dir whose projects/ holds worker transcripts (default ~/.claude).
# CLAUDE_CONFIG_DIR=
# Lock file serialising desktop control (macOS only; default <tmpdir>/jarvis-desktop.lock).
# JARVIS_DESKTOP_LOCK=
# Any value prints swallowed errors as `[ignored] <context>: <reason>` to the debug log.
# JARVIS_DEBUG=
