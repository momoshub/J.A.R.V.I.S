# Slack credentials (Socket Mode). Get these from https://api.slack.com/apps
# Bot token: OAuth & Permissions -> Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token
# App-level token: Basic Information -> App-Level Tokens (scope: connections:write)
SLACK_APP_TOKEN=xapp-your-app-token
# Stream replies live (tool calls shown as a timeline). "false" posts once at the end.
SLACK_STREAM_UPDATES=true

# Bot identity - these only bootstrap a fresh database. Once set, the dashboard-managed
# values in the DB take precedence, so the code stays generic.
BOT_NAME=Assistant
BOT_THINKING_LABEL=working on it...

# E.V.'s brain: "claude-cli" wraps your local Claude Code CLI (full tool access),
# "anthropic" calls the API directly.
LLM_PROVIDER=claude-cli

# --- claude-cli provider ---
# Path/name of the claude binary
CLAUDE_BIN=claude
# Model alias or id passed to the CLI (e.g. opus, sonnet, claude-opus-4-8)
CLAUDE_MODEL=opus
# Pass --dangerously-skip-permissions so E.V. has full tool permissions
CLAUDE_SKIP_PERMISSIONS=true
# Working directory the CLI runs in (scopes file/tool access). Leave blank to use
# a neutral dir outside E.V.'s own source (so she never treats this repo as "her
# job"). Set to a project path if you want her tools to operate there.
CLAUDE_CWD=
# Hard timeout per reply, ms
CLAUDE_TIMEOUT_MS=120000

# --- anthropic provider (only needed when LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Command interfaces. COMMAND_PREFIX is the message trigger (the legacy "!" always
# works too); SLASH_COMMAND is the Slack slash command you register in the app.
COMMAND_PREFIX=//bot
SLASH_COMMAND=/bot

# Owner Slack user id (full control, cannot be removed from the allowlist)
OWNER_SLACK_ID=U0OWNER0001

# Admin dashboard
DASHBOARD_PORT=2002
# Token required to reach the dashboard (min 24 chars). Generate with: openssl rand -hex 16
# Sent as ?token= or X-Dashboard-Token header
DASHBOARD_TOKEN=
# If you reach the dashboard through a proxy/tunnel/port-forward, add its browser
# origin(s) here (comma separated, e.g. https://abc.devtunnels.ms). Loopback is
# always allowed. A blocked POST returns the exact origin to add.
DASHBOARD_ALLOWED_ORIGINS=

# Path to the sqlite database file
DATABASE_PATH=data/ev.db
