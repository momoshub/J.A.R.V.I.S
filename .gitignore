# dependencies
node_modules/
web/node_modules/

# web build output (run `bun run build:web`)
web/dist/

# secrets
.env
.env.local

# sqlite database is committed to git (per request). its transient WAL sidecars
# are not - they are flushed into the .db on a clean shutdown.
data/*.db-shm
data/*.db-wal

# the key that opens the token database. the database itself is committed like
# the main one, but it holds ciphertext - this file is what makes it readable,
# so it stays on the host and out of git.
data/tokens.key

# bun
.bun/

# logs
*.log

# os
.DS_Store

# Claude Code's own worktrees. They are checkouts of this repo, so committing
# them embeds a repository inside itself and clones come out broken.
.claude/worktrees/

# per-thread tool traces (full tool input/output), host-only
logs/threads/

# the gateway inbox: transient traffic between two processes, host-only
data/inbox.db
data/inbox.db-shm
data/inbox.db-wal
