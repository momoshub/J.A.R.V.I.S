# dependencies
node_modules/
web/node_modules/

# web build output (run `bun run build:web`)
web/dist/

# secrets
.env
.env.local

# the live sqlite databases belong OUTSIDE the checkout (DATABASE_PATH, see
# README "Where the database lives"). The data/*.db files still tracked here are
# legacy copies, kept until every instance has moved. WAL sidecars are never
# committed - they are flushed into the .db on a clean shutdown.
data/*.db-shm
data/*.db-wal

# the key that opens the token database. the database holds ciphertext - this
# file is what makes it readable, so it stays on the host and out of git.
data/tokens.key

# bun
.bun/

# logs
*.log

# os
.DS_Store

# Claude Code's own worktrees. They are checkouts of this repo, so committing
# them embeds a repository inside itself and clones come out broken.
.claude/worktrees/

# per-thread tool traces (full tool input/output), host-only
logs/threads/

# the gateway inbox: transient traffic between two processes, host-only
data/inbox.db
data/inbox.db-shm
data/inbox.db-wal

# the memory adapter lives in the database (adapter_files); this is the copy
# rendered from it on every write, so skills can be read by path
data/adapter-mirror/

# the how-to guides written for the prompt to point at, rebuilt from code
data/prompt-guides/
