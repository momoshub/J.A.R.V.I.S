{
  "name": "slack-agent-bot",
  "version": "0.1.0",
  "description": "A configurable Slack agent bot powered by the Claude CLI, with SQLite memory, live streaming replies, and an admin dashboard",
  "type": "module",
  "private": true,
  "module": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "JARVIS_E2E=1 bun test ./e2e/slackBlockKit.e2e.ts ./e2e/slackStream.e2e.ts ./e2e/slackUpload.e2e.ts ./e2e/slackWatch.e2e.ts",
    "db:seed": "bun run src/infrastructure/db/seed.ts",
    "web:install": "cd web && bun install",
    "web:dev": "cd web && bun run dev",
    "build:web": "cd web && bun install && bun run build",
    "setup": "bun install && bun run build:web"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@slack/bolt": "^4.4.0",
    "@slack/socket-mode": "^2.0.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3"
  }
}
