#!/usr/bin/env bash
# Scan the commits being pushed with gitleaks before they leave the machine.
# Bypass (use sparingly): git push --no-verify
set -uo pipefail
root="$(git rev-parse --show-toplevel)"
scan="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/bin/leak-scan.sh"
zero="0000000000000000000000000000000000000000"
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks is not installed, skipping the leak scan (brew install gitleaks)" >&2
  exit 0
fi
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  # deleting a ref pushes no commits
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    # new branch: only the commits no remote branch has
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi
  if ! "$scan" git "$root" --redact --no-banner -v --log-opts="$range"; then
    status=1
  fi
done
if [ "$status" -ne 0 ]; then
  echo "" >&2
  echo "pre-push: BLOCKED, gitleaks found sensitive-looking content in the commits above." >&2
  echo "Remove it (amend or rewrite the commits), or for a verified false positive add it to" >&2
  echo ".gitleaks.toml / .gitleaksignore. Last resort: git push --no-verify" >&2
fi
exit "$status"
